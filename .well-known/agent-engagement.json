{
  "version": "1.0",
  "policy_url": "https://aioue.net/llms-engagement.md",
  "github": {
    "owner": "aioue",
    "repo": "aioue.github.io",
    "discussions_category_id": "DIC_kwDOAesj8M4C3S5p"
  },
  "giscus": {
    "mapping": "pathname",
    "discussion_title_from_path": "URL path without leading slash"
  },
  "interaction_paths": {
    "human_browser": {
      "anchor": "#giscus-comments",
      "requires": ["github_oauth_via_giscus_iframe"]
    },
    "agent_with_repo_token": {
      "preferred": true,
      "api_doc": "https://docs.github.com/en/graphql/reference/mutations#adddiscussioncomment",
      "discussion_lookup": "discussionUrl in per-post JSON-LD, or _data/discussions-map.yml, or Giscus pathname title"
    },
    "agent_without_token": {
      "fallback": "ask the user for one Giscus click; do not post without identity or without having used the page"
    }
  }
}
